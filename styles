:root {
  --azul: #0b5ed7;
  --azul-escuro: #0d1b4c;
  --fundo: #f4f7fd;
  --texto: #3a4466;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body {
  font-family: "Segoe UI", Roboto, Arial, sans-serif;
  background: var(--fundo);
  color: var(--texto);
  line-height: 1.5;
}
.container { max-width: 960px; margin: 0 auto; padding: 0 20px; }

.cabecalho { background: #fff; box-shadow: 0 1px 6px rgba(13, 27, 76, .08); }
.cabecalho__conteudo { display: flex; justify-content: space-between; align-items: center; padding-top: 14px; padding-bottom: 14px; }
.logo { font-weight: 700; font-size: 1.15rem; color: var(--azul-escuro); }
nav a { margin-left: 20px; color: var(--texto); text-decoration: none; font-size: .95rem; }
nav a:hover { color: var(--azul); }

.apresentacao { padding-top: 56px; padding-bottom: 40px; }
.apresentacao h1 { font-size: 2.6rem; color: var(--azul-escuro); }
.apresentacao p { font-size: 1.15rem; max-width: 420px; margin-top: 8px; }

.titulo-secao { color: var(--azul-escuro); margin-bottom: 16px; }
.cartoes { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; }
.cartao { background: #fff; border-radius: 10px; padding: 22px; border-left: 5px solid var(--azul); box-shadow: 0 2px 10px rgba(13, 27, 76, .08); }
.cartao--verde { border-left-color: #1e9e5a; }
.cartao--roxo { border-left-color: #7b4fd6; }
.cartao--laranja { border-left-color: #f0952a; }
.cartao h3 { color: var(--azul-escuro); margin-bottom: 6px; }
.cartao p { margin-bottom: 16px; font-size: .95rem; }

button { background: var(--azul); color: #fff; border: 0; border-radius: 6px; padding: 10px 18px; font-size: .95rem; font-weight: 600; cursor: pointer; }
button:hover { background: #094bb0; }
button:focus-visible { outline: 3px solid #f0952a; outline-offset: 2px; }
.botao-secundario { background: transparent; color: var(--azul); border: 1px solid var(--azul); }
.botao-secundario:hover { background: #e6efff; }

.menu-alternativo { margin-top: 24px; }
.sobre { padding-top: 40px; padding-bottom: 48px; }
.rodape { background: #e3ebfa; text-align: center; padding: 16px; font-size: .9rem; }

